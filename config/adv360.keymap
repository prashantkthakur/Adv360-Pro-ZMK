#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <185>;
        };

        tap_dance: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&to 1>, <&to 2>, <&to 3>, <&to 4>;

            tapping-term-ms = <250>;
        };
    };

    combos { compatible = "zmk,combos"; };

    macros {
        cmd_tab_sticky: cmd_tab_sticky {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LGUI &kp TAB>;
            label = "CMD_TAB_STICKY";
        };

        cmd_shift_tab: cmd_shift_tab {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&sk LGUI &kp LS(TAB)>;
            label = "CMD_SHIFT_TAB";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL        &kp N1       &kp N2        &kp N3        &kp N4     &kp N5   &tog 4                                                                &mo 4                     &kp N6   &kp N7   &kp N8             &kp N9      &kp N0          &kp MINUS
&kp TAB          &kp Q        &kp W         &kp E         &kp R      &kp T    &kp LG(C)                                                             &kp LG(LS(LC(NUMBER_3)))  &kp Y    &kp U    &kp I              &kp O       &kp P           &kp BSLH
&hm LALT ESCAPE  &hm LCTRL A  &hm LGUI S    &hm LSHIFT D  &lt 2 F    &lt 5 G  &kp LG(V)  &kp LCTRL   &kp LALT       &mt RCTRL LG(SPACE)  &kp LCMD   &kp LS(LG(LC(NUMBER_4)))  &lt 3 H  &lt 1 J  &hm RIGHT_SHIFT K  &hm RGUI L  &hm RCTRL SEMI  &hm LALT SQT
&kp LSHFT        &kp Z        &kp X         &kp C         &kp V      &kp B                           &kp HOME       &kp PG_UP                                                 &kp N    &kp M    &kp COMMA          &kp DOT     &kp FSLH        &kp RSHFT
&mo 3            &kp GRAVE    &kp CAPSLOCK  &kp LEFT      &kp RIGHT           &kp BSPC   &kp DELETE  &lt 5 END      &lt 5 PAGE_DOWN      &kp ENTER  &kp SPACE                          &kp UP   &kp DOWN           &kp LBKT    &kp RBKT        &tap_dance
            >;
        };

        symbol {
            bindings = <
&kp GRAVE  &kp EXCLAMATION    &kp AT_SIGN      &kp HASH               &kp DOLLAR     &kp PERCENT       &trans                                                                            &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp AMPERSAND      &kp PLUS         &kp EQUAL              &kp MINUS      &kp UNDERSCORE    &trans                                                                            &trans        &trans  &trans  &trans  &trans  &trans  &trans
&kp PIPE   &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp SEMICOLON  &kp LESS_THAN     &trans             &trans     &trans                    &trans        &trans      &trans        &trans  &trans  &trans  &trans  &trans  &trans
&trans     &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp COLON      &kp GREATER_THAN                                &kp CARET                 &kp ASTERISK                            &trans  &trans  &trans  &trans  &trans  &trans
&trans     &trans             &trans           &trans                 &trans                           &kp DOUBLE_QUOTES  &kp COMMA  &kp NON_US_BACKSLASH      &kp SLASH     &kp PERIOD  &kp QUESTION          &trans  &trans  &trans  &trans  &trans
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4  &kp F5  &kp F6  &tog 0                                                               &mo 4    &kp F7  &kp F8      &kp F9           &kp F10            &kp F11     &kp F12
&trans  &trans  &trans  &trans  &trans  &trans  &none                                                                &none    &trans  &trans      &kp UP_ARROW     &trans             &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans  &none        &trans            &trans      &trans  &trans            &none    &trans  &kp LEFT    &kp DOWN_ARROW   &kp RIGHT_ARROW    &kp K_NEXT  &kp K_PREV
&trans  &trans  &trans  &trans  &trans  &trans                                 &trans      &trans                             &trans  &kp K_MUTE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans      &trans
&trans  &trans  &trans  &trans  &trans          &kp LS(TAB)  &kp C_PLAY_PAUSE  &trans      &trans  &kp C_PLAY_PAUSE  &kp TAB          &trans      &trans           &trans             &trans      &kp LG(LS(Q))
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2    &bt BT_SEL 3     &bt BT_SEL 4  &none                                                          &trans           &studio_unlock  &none       &none       &none  &none  &none
&none           &none         &none           &mmv MOVE_UP    &none            &none         &bootloader                                                    &bootloader      &none           &none       &none       &none  &none  &none
&studio_unlock  &mkp LCLK     &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK     &none        &none          &none      &bt BT_CLR  &none       &stp STP_BAT     &none           &none       &none       &none  &none  &none
&none           &mkp RCLK     &mkp MB4        &mkp MB5        &mkp MB3         &none                                     &none      &none                                    &none           &none       &none       &none  &none  &none
&none           &none         &none           &none           &none                          &kp LC(C)    &kp LG(GRAVE)  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                   &mo 4      &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &none                                                    &none      &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&trans  &trans  &trans  &trans  &trans  &trans  &none     &kp ENTER  &kp LALT      &kp LGUI   &kp RCTRL  &none      &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&trans  &trans  &trans  &trans  &trans  &trans                       &kp HOME      &kp PG_UP                        &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&trans  &trans  &trans  &trans  &trans          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 3
            >;
        };

        CommandLayer {
            bindings = <
&trans  &trans            &trans             &trans  &trans         &trans     &trans                                      &trans  &trans  &trans          &trans           &trans  &trans  &trans
&trans  &trans            &trans             &trans  &trans         &trans     &trans                                      &trans  &trans  &trans          &trans           &trans  &trans  &trans
&trans  &kp LG(LA(LEFT))  &kp LG(LA(RIGHT))  &trans  &kp LG(GRAVE)  &kp LS(T)  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &cmd_shift_tab  &cmd_tab_sticky  &trans  &trans  &trans
&trans  &trans            &trans             &trans  &trans         &trans                     &trans      &trans                  &trans  &trans          &trans           &trans  &trans  &trans
&trans  &trans            &trans             &trans  &trans                    &trans  &trans  &trans      &trans  &trans  &trans          &trans          &trans           &trans  &trans  &trans
            >;
        };
    };
};
