#include <dt-bindings/zmk/stp.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <250>;
            quick_tap_ms = <200>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;

            quick-tap-ms = <185>;
        };

        tap_dance: tap_dance {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE";
            #binding-cells = <0>;
            bindings = <&to 3>, <&to 1>, <&to 5>, <&to 6>;

            tapping-term-ms = <250>;
        };

        sticky_cmd_key: sticky_cmd_key {
            compatible = "zmk,behavior-sticky-key";
            label = "STICKY_CMD_KEY";
            bindings = <&kp>;
            #binding-cells = <1>;
            release-after-ms = <2000>;
        };
    };

    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <32 41>;
            layers = <0>;
        };
    };

    macros {
        switcher: switcher {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LGUI>,
                <&macro_tap>,
                <&kp TAB>,
                <&macro_tap>,
                <&kp LGUI>,
                <&macro_release>,
                <&kp LGUI>;

            label = "SWITCHER";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp EQUAL        &kp N1       &kp N2      &kp N3        &kp N4     &kp N5   &tog 6                                                                &mo 5                     &kp N6   &kp N7   &kp N8             &kp N9      &kp N0          &kp MINUS
&kp TAB          &kp Q        &kp W       &kp E         &kp R      &kp T    &kp LG(C)                                                             &kp LG(LS(LC(NUMBER_3)))  &kp Y    &kp U    &kp I              &kp O       &kp P           &kp BSLH
&hm LALT ESCAPE  &hm LCTRL A  &hm LGUI S  &hm LSHIFT D  &lt 1 F    &lt 2 G  &kp LG(V)  &kp LCTRL   &kp LALT       &mt RCTRL LG(SPACE)  &kp LCMD   &kp LS(LG(LC(NUMBER_4)))  &lt 4 H  &lt 3 J  &hm RIGHT_SHIFT K  &hm RGUI L  &hm RCTRL SEMI  &hm LALT SQT
&kp LSHFT        &kp Z        &kp X       &kp C         &kp V      &kp B                           &kp HOME       &kp PG_UP                                                 &kp N    &kp M    &kp COMMA          &kp DOT     &kp FSLH        &kp RSHFT
&mo 5            &kp GRAVE    &caps_word  &kp LEFT      &kp RIGHT           &kp BSPC   &kp DELETE  &lt 2 END      &lt 2 PAGE_DOWN      &kp ENTER  &kp SPACE                          &kp UP   &kp DOWN           &kp LBKT    &kp RBKT        &kp LG(GRAVE)
            >;
        };

        fn {
            display-name = "Fn";
            bindings = <
&kp F1  &kp F2  &kp F3  &kp F4     &kp F5  &kp F6  &tog 0                                                                                               &mo 6                &kp F7      &kp F8      &kp F9           &kp F10            &kp F11     &kp F12
&trans  &trans  &trans  &kp ENTER  &trans  &trans  &none                                                                                                &none                &trans      &trans      &kp UP_ARROW     &trans             &trans      &trans
&trans  &trans  &trans  &trans     &trans  &trans  &none               &trans               &trans                &trans            &trans              &none                &caps_word  &kp LEFT    &kp DOWN_ARROW   &kp RIGHT_ARROW    &kp K_NEXT  &kp K_PREV
&trans  &trans  &trans  &trans     &trans  &trans                                           &trans                &trans                                                     &trans      &kp K_MUTE  &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &trans      &trans
&trans  &trans  &trans  &trans     &trans          &kp LA(LEFT_ARROW)  &kp LA(RIGHT_ARROW)  &kp C_PLAY_PAUSE      &kp C_PLAY_PAUSE  &kp LG(LEFT_ARROW)  &kp LG(RIGHT_ARROW)              &trans      &trans           &trans             &trans      &kp LG(LS(Q))
            >;
        };

        CommandLayer {
            bindings = <
&trans  &trans            &trans         &trans                 &trans                 &trans  &trans                                                          &trans                   &trans     &trans     &trans       &trans         &trans     &trans
&trans  &kp LG(Q)         &kp LG(W)      &kp LS(LA(LC(LG(E))))  &kp LG(LC(LA(LS(R))))  &trans  &trans                                                          &trans                   &kp LG(R)  &kp LG(Z)  &trans       &trans         &kp LG(P)  &trans
&trans  &kp LG(LA(LEFT))  &kp LS(LG(F))  &kp LC(GRAVE)          &trans                 &trans  &trans                  &trans      &trans      &trans  &trans  &trans                   &trans     &switcher  &kp LS(TAB)  &kp LG(GRAVE)  &trans     &trans
&trans  &trans            &trans         &trans                 &trans                 &trans                                      &trans      &trans                                   &trans     &trans     &trans       &trans         &trans     &trans
&trans  &trans            &trans         &trans                 &trans                         &kp LA(LG(LEFT_ARROW))  &kp ESCAPE  &trans      &trans  &trans  &kp LA(LG(RIGHT_ARROW))             &trans     &trans       &trans         &trans     &trans
            >;
        };

        symbol {
            bindings = <
&kp GRAVE  &kp EXCLAMATION    &kp AT_SIGN      &kp HASH               &kp DOLLAR     &kp PERCENT       &trans                                                                        &trans   &trans  &trans  &trans     &trans      &trans        &trans
&trans     &kp AMPERSAND      &kp PLUS         &kp EQUAL              &kp MINUS      &kp UNDERSCORE    &kp ASTERISK                                                                  &trans   &trans  &trans  &trans     &trans      &trans        &trans
&kp PIPE   &kp LEFT_BRACKET   &kp LEFT_BRACE   &kp LEFT_PARENTHESIS   &kp SEMICOLON  &kp LESS_THAN     &kp CARET     &trans  &trans                    &trans     &trans             &trans   &trans  &trans  &kp COMMA  &kp PERIOD  &kp QUESTION  &trans
&trans     &kp RIGHT_BRACKET  &kp RIGHT_BRACE  &kp RIGHT_PARENTHESIS  &kp COLON      &kp GREATER_THAN                        &trans                    &trans                                 &trans  &trans  &trans     &trans      &trans        &trans
&trans     &trans             &trans           &trans                 &trans                           &trans        &trans  &kp NON_US_BACKSLASH      &kp SLASH  &kp DOUBLE_QUOTES  &kp SQT          &trans  &trans     &trans      &trans        &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans     &trans          &trans          &trans           &trans     &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans          &mmv MOVE_UP    &trans           &trans     &trans                                      &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp LCLK  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &mkp RCLK  &trans  &trans  &trans      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &mkp RCLK  &mkp MB4        &mkp MB5        &mkp MB3         &trans                     &trans      &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans     &trans          &trans          &trans                      &trans  &trans  &trans      &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
            >;
        };

        mod {
            display-name = "Mod";
            bindings = <
&none           &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans           &studio_unlock  &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none         &bootloader                                            &bootloader      &none           &none       &none       &none  &none  &none
&studio_unlock  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &stp STP_BAT     &none           &none       &none       &none  &none  &none
&none           &none         &none         &none         &none         &none                             &none      &none                                    &none           &none       &none       &none  &none  &none
&none           &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                  &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };

        keypad {
            display-name = "Kp";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &trans                                                   &none      &trans  &kp KP_NUM  &kp KP_EQUAL  &kp KP_DIVIDE  &kp KP_MULTIPLY  &kp MINUS
&trans  &trans  &trans  &trans  &trans  &trans  &none                                                    &none      &trans  &kp KP_N7   &kp KP_N8     &kp KP_N9      &kp KP_MINUS     &kp BSLH
&trans  &trans  &trans  &trans  &trans  &trans  &none     &kp ENTER  &kp LALT      &kp LGUI   &kp RCTRL  &none      &trans  &kp KP_N4   &kp KP_N5     &kp KP_N6      &kp KP_PLUS      &kp SQT
&trans  &trans  &trans  &trans  &trans  &trans                       &kp HOME      &kp PG_UP                        &trans  &kp KP_N1   &kp KP_N2     &kp KP_N3      &kp KP_ENTER     &kp RSHFT
&trans  &trans  &trans  &trans  &trans          &kp BSPC  &kp DEL    &kp END       &kp PG_DN  &kp ENTER  &kp KP_N0          &kp UP      &kp DOWN      &kp KP_DOT     &kp RBKT         &mo 5
            >;
        };
    };
};
